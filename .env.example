# Application
APP_NAME=MLOps QC Platform
APP_VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=postgresql://admin:secret@localhost:5432/mlops_qc
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET=mlops-qc

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# JWT
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=visual-qc

# DVC
DVC_REMOTE=s3://mlops-qc/dvc

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=["jpeg","jpg","png"]

# Model Inference
DEFAULT_CONFIDENCE_THRESHOLD=0.5
DEFAULT_NMS_IOU_THRESHOLD=0.45
MAX_BATCH_SIZE=16
