ted-foreground\">\n                    Vue d'ensemble complète de la plateforme MLOps QC\n                </p>\n            </div>\n\n            {/* Statistiques Globales */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <StatsCard\n                    title=\"Utilisateurs\"\n                    value={totalUsers}\n                    icon={Users}\n                    description=\"Utilisateurs actifs\"\n                    href=\"/settings/users\"\n                    color=\"text-purple-600\"\n                />\n                <StatsCard\n                    title=\"Projets\"\n                    value={totalProjects}\n                    icon={FolderKanban}\n                    description=\"Projets actifs\"\n                    href=\"/projects\"\n                    color=\"text-blue-600\"\n                />\n                <StatsCard\n                    title=\"Modèles\"\n                    value={totalModels}\n                    icon={Brain}\n                    description=\"Modèles entraînés\"\n                    href=\"/models\"\n                    color=\"text-green-600\"\n                />\n                <StatsCard\n                    title=\"Images\"\n                    value={totalImages}\n                    icon={FileText}\n                    description=\"Images totales\"\n                    href=\"/images\"\n                    color=\"text-orange-600\"\n                />\n            </div>\n\n            {/* Actions Rapides */}\n            <DashboardSection title=\"Actions Rapides\" description=\"Accès rapide aux fonctionnalités principales\">\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                    <QuickActionCard\n                        title=\"Gérer les Utilisateurs\"\n                        description=\"Ajouter, modifier ou supprimer des utilisateurs\"\n                        icon={Users}\n                        href=\"/settings/users\"\n                    />\n                    <QuickActionCard\n                        title=\"Créer un Projet\"\n                        description=\"Démarrer un nouveau projet de détection\"\n                        icon={Plus}\n                        href=\"/projects\"\n                    />\n                    <QuickActionCard\n                        title=\"Voir les Paramètres\"\n                        description=\"Configuration système et préférences\"\n                        icon={Settings}\n                        href=\"/settings\"\n                        variant=\"outline\"\n                    />\n                </div>\n            </DashboardSection>\n\n            {/* Projets Récents */}\n            <DashboardSection\n                title=\"Projets Récents\"\n                description=\"Derniers projets créés ou modifiés\"\n                action={{ label: \"Voir tous\", href: \"/projects\" }}\n            >\n                <Card>\n                    <CardContent className=\"pt-6\">\n                        {projects && projects.length > 0 ? (\n                            <div className=\"space-y-2\">\n                                {projects.slice(0, 5).map((project) => (\n                                    <RecentActivityItem\n                                        key={project.id}\n                                        title={project.name}\n                                        description={`${project.total_images || 0} images • ${project.models_count || 0} modèles`}\n                                        time=\"Récent\"\n                                        icon={FolderKanban}\n                                        href={`/projects/${project.id}`}\n                                    />\n                                ))}\n                            </div>\n                        ) : (\n                            <div className=\"text-center py-8 text-muted-foreground\">\n                                <p>Aucun projet pour le moment</p>\n                            </div>\n                        )}\n                    </CardContent>\n                </Card>\n            </DashboardSection>\n\n            {/* Activité Système */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n                <Card>\n                    <CardHeader>\n                        <CardTitle className=\"flex items-center\">\n                            <Activity className=\"h-5 w-5 mr-2 text-blue-600\" />\n                            Activité Récente\n                        </CardTitle>\n                    </CardHeader>\n                    <CardContent>\n                        <div className=\"space-y-2\">\n                            <RecentActivityItem\n                                title=\"Nouveau projet créé\"\n                                description=\"Surface Detection Project\"\n                                time=\"Il y a 2h\"\n                            />\n                            <RecentActivityItem\n                                title=\"Utilisateur ajouté\"\n                                description=\"operator@test.com\"\n                                time=\"Il y a 5h\"\n                            />\n                            <RecentActivityItem\n                                title=\"Modèle déployé\"\n                                description=\"YOLOv8 - Défauts de surface\"\n                                time=\"Il y a 1j\"\n                            />\n                        </div>\n                    </CardContent>\n                </Card>\n\n                <Card>\n                    <CardHeader>\n                        <CardTitle className=\"flex items-center\">\n                            <Zap className=\"h-5 w-5 mr-2 text-green-600\" />\n                            Entraînements en Cours\n                        </CardTitle>\n                    </CardHeader>\n                    <CardContent>\n                        {activeTrainings > 0 ? (\n                            <div className=\"space-y-2\">\n                                <p className=\"text-sm text-muted-foreground\">\n                                    {activeTrainings} entraînement(s) en cours\n                                </p>\n                            </div>\n                        ) : (\n                            <div className=\"text-center py-8 text-muted-foreground\">\n                                <p className=\"text-sm\">Aucun entraînement en cours</p>\n                            </div>\n                        )}\n                    </CardContent>\n                </Card>\n            </div>\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/mac/mlops-qc-platform/frontend/src/components/dashboard/ChefOperatorDashboard.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":34,"column":75,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1408,1507],"text":"\n                    Gestion des projets, entraînements et supervision de l&apos;équipe\n                "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1408,1507],"text":"\n                    Gestion des projets, entraînements et supervision de l&lsquo;équipe\n                "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[1408,1507],"text":"\n                    Gestion des projets, entraînements et supervision de l&#39;équipe\n                "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[1408,1507],"text":"\n                    Gestion des projets, entraînements et supervision de l&rsquo;équipe\n                "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useProjects } from \"@/lib/hooks/useProjects\";\nimport { StatsCard, QuickActionCard, DashboardSection, ProjectOverviewCard } from \"./DashboardWidgets\";\nimport { FolderKanban, Brain, Zap, Plus, Upload, TrendingUp } from \"lucide-react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\n\nexport function ChefOperatorDashboard() {\n    const { data: projects, isLoading } = useProjects();\n\n    // Calculs statistiques\n    const totalProjects = projects?.length || 0;\n    const totalImages = projects?.reduce((acc, p) => acc + (p.total_images || 0), 0) || 0;\n    const totalModels = projects?.reduce((acc, p) => acc + (p.models_count || 0), 0) || 0;\n    const annotatedImages = projects?.reduce((acc, p) => acc + (p.annotated_images || 0), 0) || 0;\n\n    // Calcul du taux d'annotation\n    const annotationRate = totalImages > 0 ? Math.round((annotatedImages / totalImages) * 100) : 0;\n\n    if (isLoading) {\n        return (\n            <div className=\"flex items-center justify-center h-96\">\n                <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600\"></div>\n            </div>\n        );\n    }\n\n    return (\n        <div className=\"space-y-6\">\n            {/* Header */}\n            <div>\n                <h1 className=\"text-3xl font-bold\">Dashboard Chef Opérateur</h1>\n                <p className=\"text-muted-foreground\">\n                    Gestion des projets, entraînements et supervision de l'équipe\n                </p>\n            </div>\n\n            {/* Statistiques d'Équipe */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <StatsCard\n                    title=\"Projets\"\n                    value={totalProjects}\n                    icon={FolderKanban}\n                    description=\"Projets gérés\"\n                    href=\"/projects\"\n                    color=\"text-blue-600\"\n                />\n                <StatsCard\n                    title=\"Images Totales\"\n                    value={totalImages}\n                    icon={Upload}\n                    description=\"Dans tous les projets\"\n                    href=\"/images\"\n                    color=\"text-green-600\"\n                />\n                <StatsCard\n                    title=\"Taux d'Annotation\"\n                    value={`${annotationRate}%`}\n                    icon={TrendingUp}\n                    description={`${annotatedImages} / ${totalImages} images`}\n                    color=\"text-purple-600\"\n                />\n                <StatsCard\n                    title=\"Modèles\"\n                    value={totalModels}\n                    icon={Brain}\n                    description=\"Modèles entraînés\"\n                    href=\"/models\"\n                    color=\"text-orange-600\"\n                />\n            </div>\n\n            {/* Actions Rapides de Supervision */}\n            <DashboardSection title=\"Actions Rapides\" description=\"Accès rapide aux fonctionnalités de gestion\">\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                    <QuickActionCard\n                        title=\"Créer un Projet\"\n                        description=\"Démarrer un nouveau projet de détection\"\n                        icon={Plus}\n                        href=\"/projects\"\n                    />\n                    <QuickActionCard\n                        title=\"Entraîner un Modèle\"\n                        description=\"Lancer un nouvel entraînement\"\n                        icon={Brain}\n                        href=\"/models\"\n                    />\n                    <QuickActionCard\n                        title=\"Déployer un Modèle\"\n                        description=\"Mettre un modèle en production\"\n                        icon={Zap}\n                        href=\"/inference/detect\"\n                        variant=\"outline\"\n                    />\n                </div>\n            </DashboardSection>\n\n            {/* Mes Projets */}\n            <DashboardSection\n                title=\"Mes Projets\"\n                description=\"Projets en cours de gestion\"\n                action={{ label: \"Voir tous\", href: \"/projects\" }}\n            >\n                {projects && projects.length > 0 ? (\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                        {projects.slice(0, 6).map((project) => (\n                            <ProjectOverviewCard key={project.id} project={project} />\n                        ))}\n                    </div>\n                ) : (\n                    <Card>\n                        <CardContent className=\"py-12 text-center text-muted-foreground\">\n                            <p className=\"mb-4\">Aucun projet pour le moment</p>\n                            <p className=\"text-sm\">Créez votre premier projet pour commencer</p>\n                        </CardContent>\n                    </Card>\n                )}\n            </DashboardSection>\n\n            {/* Entraînements Actifs */}\n            <Card>\n                <CardHeader>\n                    <CardTitle className=\"flex items-center\">\n                        <Brain className=\"h-5 w-5 mr-2 text-blue-600\" />\n                        Entraînements en Cours\n                    </CardTitle>\n                </CardHeader>\n                <CardContent>\n                    <div className=\"text-center py-8 text-muted-foreground\">\n                        <p className=\"text-sm\">Aucun entraînement en cours</p>\n                        <p className=\"text-xs mt-2\">Les entraînements actifs apparaîtront ici</p>\n                    </div>\n                </CardContent>\n            </Card>\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/mac/mlops-qc-platform/frontend/src/components/dashboard/DashboardWidgets.tsx","messages":[{"ruleId":"react-hooks/static-components","severity":2,"message":"Error: Cannot create components during render\n\nComponents created during render will reset their state each time they are created. Declare components outside of render.\n\n/Users/mac/mlops-qc-platform/frontend/src/components/dashboard/DashboardWidgets.tsx:88:10\n  86 |\n  87 |     return (\n> 88 |         <CardWrapper>\n     |          ^^^^^^^^^^^ This component is created during render\n  89 |             <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n  90 |                 <CardTitle className=\"text-sm font-medium text-muted-foreground\">\n  91 |                     {title}\n\n/Users/mac/mlops-qc-platform/frontend/src/components/dashboard/DashboardWidgets.tsx:76:25\n  74 |     color = \"text-blue-600\"\n  75 | }: StatsCardProps) {\n> 76 |     const CardWrapper = ({ children }: { children: ReactNode }) =>\n     |                         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 77 |         href ? (\n     | ^^^^^^^^^^^^^^^^\n> 78 |             <Link href={href}>\n     | ^^^^^^^^^^^^^^^^\n> 79 |                 <Card className=\"hover:shadow-lg transition cursor-pointer\">\n     | ^^^^^^^^^^^^^^^^\n> 80 |                     {children}\n     | ^^^^^^^^^^^^^^^^\n> 81 |                 </Card>\n     | ^^^^^^^^^^^^^^^^\n> 82 |             </Link>\n     | ^^^^^^^^^^^^^^^^\n> 83 |         ) : (\n     | ^^^^^^^^^^^^^^^^\n> 84 |             <Card>{children}</Card>\n     | ^^^^^^^^^^^^^^^^\n> 85 |         );\n     | ^^^^^^^^^^ The component is created during render here\n  86 |\n  87 |     return (\n  88 |         <CardWrapper>","line":88,"column":10,"nodeType":null,"endLine":88,"endColumn":21}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { ReactNode } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { LucideIcon } from \"lucide-react\";\nimport Link from \"next/link\";\nimport { cn } from \"@/lib/utils\";\n\n// Types\ninterface StatsCardProps {\n    title: string;\n    value: string | number;\n    icon: LucideIcon;\n    description?: string;\n    href?: string;\n    trend?: {\n        value: number;\n        isPositive: boolean;\n    };\n    color?: string;\n}\n\ninterface QuickActionCardProps {\n    title: string;\n    description: string;\n    icon: LucideIcon;\n    onClick?: () => void;\n    href?: string;\n    variant?: \"default\" | \"outline\" | \"secondary\";\n}\n\ninterface RecentActivityItemProps {\n    title: string;\n    description: string;\n    time: string;\n    icon?: LucideIcon;\n    href?: string;\n}\n\ninterface ProjectOverviewCardProps {\n    project: {\n        id: string;\n        name: string;\n        description?: string;\n        total_images?: number;\n        annotated_images?: number;\n        models_count?: number;\n        status?: string;\n    };\n}\n\ninterface DashboardSectionProps {\n    title: string;\n    description?: string;\n    children: ReactNode;\n    action?: {\n        label: string;\n        href?: string;\n        onClick?: () => void;\n    };\n}\n\n/**\n * Carte de statistique avec icône, titre, valeur et optionnellement un trend\n */\nexport function StatsCard({\n    title,\n    value,\n    icon: Icon,\n    description,\n    href,\n    trend,\n    color = \"text-blue-600\"\n}: StatsCardProps) {\n    const CardWrapper = ({ children }: { children: ReactNode }) =>\n        href ? (\n            <Link href={href}>\n                <Card className=\"hover:shadow-lg transition cursor-pointer\">\n                    {children}\n                </Card>\n            </Link>\n        ) : (\n            <Card>{children}</Card>\n        );\n\n    return (\n        <CardWrapper>\n            <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n                <CardTitle className=\"text-sm font-medium text-muted-foreground\">\n                    {title}\n                </CardTitle>\n                <Icon className={cn(\"h-4 w-4\", color)} />\n            </CardHeader>\n            <CardContent>\n                <div className=\"text-3xl font-bold\">{value}</div>\n                {description && (\n                    <p className=\"text-xs text-muted-foreground mt-1\">{description}</p>\n                )}\n                {trend && (\n                    <div className=\"flex items-center mt-2 text-xs\">\n                        <span\n                            className={cn(\n                                \"font-medium\",\n                                trend.isPositive ? \"text-green-600\" : \"text-red-600\"\n                            )}\n                        >\n                            {trend.isPositive ? \"+\" : \"\"}\n                            {trend.value}%\n                        </span>\n                        <span className=\"text-muted-foreground ml-1\">vs dernier mois</span>\n                    </div>\n                )}\n            </CardContent>\n        </CardWrapper>\n    );\n}\n\n/**\n * Carte d'action rapide avec bouton\n */\nexport function QuickActionCard({\n    title,\n    description,\n    icon: Icon,\n    onClick,\n    href,\n    variant = \"default\"\n}: QuickActionCardProps) {\n    const content = (\n        <Card className=\"hover:shadow-md transition cursor-pointer\">\n            <CardHeader>\n                <div className=\"flex items-center space-x-3\">\n                    <div className={cn(\n                        \"p-2 rounded-lg\",\n                        variant === \"default\" ? \"bg-blue-100\" : \"bg-gray-100\"\n                    )}>\n                        <Icon className={cn(\n                            \"h-5 w-5\",\n                            variant === \"default\" ? \"text-blue-600\" : \"text-gray-600\"\n                        )} />\n                    </div>\n                    <div>\n                        <CardTitle className=\"text-base\">{title}</CardTitle>\n                        <CardDescription className=\"text-sm\">{description}</CardDescription>\n                    </div>\n                </div>\n            </CardHeader>\n        </Card>\n    );\n\n    if (href) {\n        return <Link href={href}>{content}</Link>;\n    }\n\n    return <div onClick={onClick}>{content}</div>;\n}\n\n/**\n * Item d'activité récente\n */\nexport function RecentActivityItem({\n    title,\n    description,\n    time,\n    icon: Icon,\n    href\n}: RecentActivityItemProps) {\n    const content = (\n        <div className=\"flex items-start space-x-3 p-3 rounded-lg hover:bg-gray-50 transition\">\n            {Icon && (\n                <div className=\"p-2 bg-gray-100 rounded-lg mt-1\">\n                    <Icon className=\"h-4 w-4 text-gray-600\" />\n                </div>\n            )}\n            <div className=\"flex-1 min-w-0\">\n                <p className=\"text-sm font-medium text-gray-900 truncate\">{title}</p>\n                <p className=\"text-sm text-gray-500 truncate\">{description}</p>\n            </div>\n            <span className=\"text-xs text-gray-400 whitespace-nowrap\">{time}</span>\n        </div>\n    );\n\n    if (href) {\n        return <Link href={href}>{content}</Link>;\n    }\n\n    return content;\n}\n\n/**\n * Carte d'aperçu de projet avec progression\n */\nexport function ProjectOverviewCard({ project }: ProjectOverviewCardProps) {\n    const progress = project.total_images\n        ? Math.round(((project.annotated_images || 0) / project.total_images) * 100)\n        : 0;\n\n    return (\n        <Link href={`/projects/${project.id}`}>\n            <Card className=\"hover:shadow-lg transition cursor-pointer\">\n                <CardHeader>\n                    <div className=\"flex justify-between items-start\">\n                        <div className=\"flex-1\">\n                            <CardTitle className=\"text-lg\">{project.name}</CardTitle>\n                            {project.description && (\n                                <CardDescription className=\"mt-1 line-clamp-2\">\n                                    {project.description}\n                                </CardDescription>\n                            )}\n                        </div>\n                        {project.status && (\n                            <span\n                                className={cn(\n                                    \"px-2 py-1 text-xs font-medium rounded-full\",\n                                    project.status === \"active\"\n                                        ? \"bg-green-100 text-green-800\"\n                                        : \"bg-gray-100 text-gray-800\"\n                                )}\n                            >\n                                {project.status === \"active\" ? \"Actif\" : \"Inactif\"}\n                            </span>\n                        )}\n                    </div>\n                </CardHeader>\n                <CardContent>\n                    <div className=\"grid grid-cols-3 gap-4 mb-3\">\n                        <div>\n                            <p className=\"text-xs text-muted-foreground\">Images</p>\n                            <p className=\"text-lg font-semibold\">{project.total_images || 0}</p>\n                        </div>\n                        <div>\n                            <p className=\"text-xs text-muted-foreground\">Annoté</p>\n                            <p className=\"text-lg font-semibold\">{project.annotated_images || 0}</p>\n                        </div>\n                        <div>\n                            <p className=\"text-xs text-muted-foreground\">Modèles</p>\n                            <p className=\"text-lg font-semibold\">{project.models_count || 0}</p>\n                        </div>\n                    </div>\n                    {project.total_images && project.total_images > 0 && (\n                        <div>\n                            <div className=\"flex justify-between text-xs text-muted-foreground mb-1\">\n                                <span>Progression</span>\n                                <span>{progress}%</span>\n                            </div>\n                            <div className=\"w-full bg-gray-200 rounded-full h-2\">\n                                <div\n                                    className=\"bg-blue-600 h-2 rounded-full transition-all\"\n                                    style={{ width: `${progress}%` }}\n                                />\n                            </div>\n                        </div>\n                    )}\n                </CardContent>\n            </Card>\n        </Link>\n    );\n}\n\n/**\n * Section de dashboard avec titre et action optionnelle\n */\nexport function DashboardSection({\n    title,\n    description,\n    children,\n    action\n}: DashboardSectionProps) {\n    return (\n        <div className=\"space-y-4\">\n            <div className=\"flex justify-between items-center\">\n                <div>\n                    <h2 className=\"text-2xl font-bold\">{title}</h2>\n                    {description && (\n                        <p className=\"text-muted-foreground text-sm\">{description}</p>\n                    )}\n                </div>\n                {action && (\n                    action.href ? (\n                        <Link href={action.href}>\n                            <Button>{action.label}</Button>\n                        </Link>\n                    ) : (\n                        <Button onClick={action.onClick}>{action.label}</Button>\n                    )\n                )}\n            </div>\n            {children}\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/mac/mlops-qc-platform/frontend/src/components/dashboard/OperatorDashboard.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":31,"column":33,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1258,1334],"text":"\n                    Vos tâches d&apos;annotation et d'inférence\n                "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1258,1334],"text":"\n                    Vos tâches d&lsquo;annotation et d'inférence\n                "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[1258,1334],"text":"\n                    Vos tâches d&#39;annotation et d'inférence\n                "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[1258,1334],"text":"\n                    Vos tâches d&rsquo;annotation et d'inférence\n                "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":31,"column":49,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1258,1334],"text":"\n                    Vos tâches d'annotation et d&apos;inférence\n                "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1258,1334],"text":"\n                    Vos tâches d'annotation et d&lsquo;inférence\n                "},"desc":"Replace with `&lsquo;`."},{"messageId":"replac